---
// src/pages/projects/android-weather/demos.astro

import PageLayout from '../../../layouts/PageLayout.astro';
import SEO from '../../../components/SEO.astro';

const videos = [
  { src: "/android/alice_dark_biloxi_midland_okc.webm", title: "alice_dark_biloxi_midland_okc" },
  { src: "/android/alice_dark_carmel_lansing.webm", title: "alice_dark_carmel_lansing" },
  { src: "/android/alice_light_denver_fairbanks_minneapolis.webm", title: "alice_light_denver_fairbanks_minneapolis" },
  { src: "/android/brave_bob_dark_dallas_lancaster.webm", title: "brave_bob_dark_dallas_lancaster" },
  { src: "/android/cool_cal_nyc_la_chi.webm", title: "cool_cal_nyc_la_chi" },
  { src: "/android/cosmo_cal_dark_northstpaul_desmoines.webm", title: "cosmo_cal_dark_northstpaul_desmoines" },
];
---

<PageLayout
  pageTitle="Android Weather — Video Demonstrations"
  pageIntro="Recorded application workflows and demonstrations."
>
  <SEO
    slot="head"
    title="Android Weather — Demonstrations"
    description="Recorded Android Weather application demonstrations."
  />

  <div class="video-grid">
    {videos.map((video) => (
      <figure>
        <video
          src={video.src}
          controls
          preload="metadata"
          playsinline
        />
        <figcaption>{video.title}</figcaption>
      </figure>
    ))}
  </div>


  <p class="back-link">
    <a href="/projects/android-weather-app/">← Back to project</a>
  </p>
</PageLayout>

<style>
  .video-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }

  figure {
    margin: 0;
    min-width: 0;
  }

  video {
    display: block;
    width: 100%;
    height: auto;
    background: #111;
    border-radius: 6px;
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    text-align: center;
  }

  .back-link {
    margin-top: 2rem;
  }

  @media (max-width: 600px) {
    .video-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
